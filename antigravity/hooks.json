{
  "hooks": {
    "AfterTool": [
      {
        "matcher": "run_shell_command|read_file|list_directory",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/antigravity/hook_aftertool.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}/src/hook_session.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
